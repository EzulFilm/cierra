# NOTE: this look was made to sit on top of a film-print emulation (not included). Without it, and with
# display_encode() (no tone scale), bright frames clip; as a standalone look it needs a tone-mapped output.
cierra 0.1

name "Teal night"
about "Cooler, deeper: teal shadows, cool surroundings, skin and warm practicals kept warm (the cool shift skips skin hues via an HSL qualifier), gentle glow on highlights. The teal shadows skip skin tones. 18 % grey at L* ~45."
input linear_rec709
output display_encode()

node tone = curve(points: [[0.0729, 0.0729], [0.0866, 0.0822], [0.0882, 0.0892], [0.0924, 0.1056], [0.1074, 0.1488], [0.1653, 0.2207], [0.2683, 0.3153], [0.3654, 0.396], [0.4423, 0.4552], [0.4957, 0.4975], [0.5273, 0.5242], [0.5474, 0.5405], [0.5543, 0.5479]])
  label "tone"
node cool = white_balance(temperature: -0.35, tint: 0.05)
  label "cool (everything except skin tones)"
  mask not qualifier(hue: 118..164, sat: 0.008..1, lum: 0.05..0.95, soft: 0.06)
node keep_practicals_warm = white_balance(temperature: 0.35, tint: -0.05)
  label "keep practicals warm (undo the cool shift above ~1 stop under display white)"
  mask luma(range: 0.49..1.3, soft: 0.03)
node teal_shadows = wheels(lift: [-0.012, 0.004, 0.016], gamma: [-0.004, 0, 0.006], gain: [0.012, 0.004, -0.01])
  label "teal shadows (not on skin)"
  mask not qualifier(hue: 118..164, sat: 0.008..1, soft: 0.06)
node warm_skin_teal_up = hue_vs_sat(points: [[141, 1.12, 45], [310, 1.2, 50], [220, 0.85, 40]])
  label "warm skin and practicals, teal up, greens down"
node skin_protect = saturation(protect_skin: 1)
  label "skin protect"
node glow = glow(threshold: 0.62, strength: 0.25, warm: 0.15)
  label "glow"
node skin_hold = saturation(amount: 0.95)
  label "skin hold: skin keeps its own colour"
  mask qualifier(hue: 128..156, sat: 0.006..0.09, lum: 0.2..0.65)

graph tone -> cool -> keep_practicals_warm -> teal_shadows -> warm_skin_teal_up -> skin_protect -> glow -> skin_hold
