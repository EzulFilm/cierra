__DEVICE__ float3 n_q(float r, float g, float b, int p_X, int p_Y, int p_W, int p_H, float p_scale) {
    float o0, o1, o2;
    float y = cr_luma(r, g, b);
    float cb = (b - y) / 1.8556f, cr = (r - y) / 1.5748f;
    float k = 1.2f;
    float y2 = y, cb2 = cb * k, cr2 = cr * k;
    o0 = y2 + 1.5748f * cr2; o2 = y2 + 1.8556f * cb2; o1 = (y2 - 0.2126f * o0 - 0.0722f * o2) / 0.7152f;
    float m1 = 1.0f;
    {
      float qy = cr_luma(r, g, b), qcb = (b - qy) / 1.8556f, qcr = (r - qy) / 1.5748f;
      float qc = _sqrtf(qcb * qcb + qcr * qcr);
      float qh = qc < 1e-05f ? 0.0f : cr_hue(qcb, qcr);
      m1 *= 1.0f - cr_smoothstep(30.0f, 48.0f, _fabs(cr_mod360(qh - 0.0f + 180.0f) - 180.0f));
      m1 *= cr_band(qc, 0.01f, 0.5f, 0.01f);
      m1 *= cr_band(qy, 0.2f, 0.8f, 0.05f);
    }
    float m2 = 1.0f;
    {
      float qy = cr_luma(r, g, b), qcb = (b - qy) / 1.8556f, qcr = (r - qy) / 1.5748f;
      float qc = _sqrtf(qcb * qcb + qcr * qcr);
      float qh = qc < 1e-05f ? 0.0f : cr_hue(qcb, qcr);
      m2 *= 1.0f - cr_smoothstep(15.0f, 33.0f, _fabs(cr_mod360(qh - 141.0f + 180.0f) - 180.0f));
      m2 *= cr_band(qc, 0.006f, 0.09f, 0.01f);
      m2 *= cr_band(qy, 0.15f, 0.7f, 0.05f);
    }
    float w = (1.0f * _fmaxf(m1, m2));
    return make_float3(r + (o0 - r) * w, g + (o1 - g) * w, b + (o2 - b) * w);
}

__DEVICE__ float3 n_lm(float r, float g, float b, int p_X, int p_Y, int p_W, int p_H, float p_scale) {
    float o0, o1, o2;
    o0 = cr_cct_enc(cr_cct_dec(r) * 0.812252396f);
    o1 = cr_cct_enc(cr_cct_dec(g) * 0.812252396f);
    o2 = cr_cct_enc(cr_cct_dec(b) * 0.812252396f);
    float m1 = cr_band(cr_luma(r, g, b), 0.1f, 0.5f, 0.05f);
    float w = (0.7f * (1.0f - m1));
    return make_float3(r + (o0 - r) * w, g + (o1 - g) * w, b + (o2 - b) * w);
}

__DEVICE__ float3 n_win(float r, float g, float b, int p_X, int p_Y, int p_W, int p_H, float p_scale) {
    float o0, o1, o2;
    o0 = cr_cct_enc(cr_cct_dec(r) * 1.23114441f);
    o1 = cr_cct_enc(cr_cct_dec(g) * 1.23114441f);
    o2 = cr_cct_enc(cr_cct_dec(b) * 1.23114441f);
    float m1;
    {
      float wx = p_W > 1 ? (float)p_X / (float)(p_W - 1) : 0.0f;
      float wy = p_H > 1 ? (float)p_Y / (float)(p_H - 1) : 0.0f;
      float ex = (wx - 0.4f) / 0.3f, ey = (wy - 0.6f) / 0.2f;
      m1 = 1.0f - cr_smoothstep(0.6f, 1.4f, _sqrtf(ex * ex + ey * ey));
    }
    float w = (1.0f * m1);
    return make_float3(r + (o0 - r) * w, g + (o1 - g) * w, b + (o2 - b) * w);
}

__DEVICE__ float3 n_vg(float r, float g, float b, int p_X, int p_Y, int p_W, int p_H, float p_scale) {
    float o0, o1, o2;
    float xx = (p_W > 1 ? 2.0f * (float)p_X / (float)(p_W - 1) : 0.0f) - 1.0f;
    float yy = (p_H > 1 ? 2.0f * (float)p_Y / (float)(p_H - 1) : 0.0f) - 1.0f;
    float ax = xx * _powf((float)p_W / (float)p_H, 0.5f);
    float rr = _sqrtf(ax * ax + yy * yy) / 1.4142135623730951f;
    float dv = 0.0456621005f * cr_smoothstep(0.4f, 1.2f, rr);
    o0 = r - dv; o1 = g - dv; o2 = b - dv;
    float w = 1.0f;
    return make_float3(r + (o0 - r) * w, g + (o1 - g) * w, b + (o2 - b) * w);
}

__DEVICE__ float3 n_gr(float r, float g, float b, int p_X, int p_Y, int p_W, int p_H, float p_scale) {
    float o0, o1, o2;
    float gs = _fmaxf(2.0f * p_scale, 0.001f);
    float gx = (float)p_X / gs, gy = (float)p_Y / gs;
    float mono = cr_grain(gx, gy, 5, 11, 3);
    float yl = _clampf(cr_luma(r, g, b), 0.0f, 1.0f), resp = 4.0f * yl * (1.0f - yl);
    o0 = r + 0.004f * (mono + 0.5f * (cr_grain(gx, gy, 5, 11, 0) - mono)) * resp;
    o1 = g + 0.004f * (mono + 0.5f * (cr_grain(gx, gy, 5, 11, 1) - mono)) * resp;
    o2 = b + 0.004f * (mono + 0.5f * (cr_grain(gx, gy, 5, 11, 2) - mono)) * resp;
    float w = 1.0f;
    return make_float3(r + (o0 - r) * w, g + (o1 - g) * w, b + (o2 - b) * w);
}

__DEVICE__ float3 n_pa(float r, float g, float b, int p_X, int p_Y, int p_W, int p_H, float p_scale) {
    float o0, o1, o2;
    o0 = cr_cct_enc(cr_cct_dec(r) * 1.41421356f);
    o1 = cr_cct_enc(cr_cct_dec(g) * 1.41421356f);
    o2 = cr_cct_enc(cr_cct_dec(b) * 1.41421356f);
    float w = 1.0f;
    return make_float3(r + (o0 - r) * w, g + (o1 - g) * w, b + (o2 - b) * w);
}

__DEVICE__ float3 n_pb(float r, float g, float b, int p_X, int p_Y, int p_W, int p_H, float p_scale) {
    float o0, o1, o2;
    float y = cr_luma(r, g, b);
    float cb = (b - y) / 1.8556f, cr = (r - y) / 1.5748f;
    float k = 0.5f;
    float y2 = y, cb2 = cb * k, cr2 = cr * k;
    o0 = y2 + 1.5748f * cr2; o2 = y2 + 1.8556f * cb2; o1 = (y2 - 0.2126f * o0 - 0.0722f * o2) / 0.7152f;
    float w = 1.0f;
    return make_float3(r + (o0 - r) * w, g + (o1 - g) * w, b + (o2 - b) * w);
}

__DEVICE__ float3 n_la(float r, float g, float b, int p_X, int p_Y, int p_W, int p_H, float p_scale) {
    float o0, o1, o2;
    o0 = cr_cct_enc(cr_cct_dec(r) * 2.0f);
    o1 = cr_cct_enc(cr_cct_dec(g) * 2.0f);
    o2 = cr_cct_enc(cr_cct_dec(b) * 2.0f);
    float w = 1.0f;
    return make_float3(r + (o0 - r) * w, g + (o1 - g) * w, b + (o2 - b) * w);
}

__DEVICE__ float3 n_lb(float r, float g, float b, int p_X, int p_Y, int p_W, int p_H, float p_scale) {
    float o0, o1, o2;
    o0 = (r - 0.4135884f) * 1.3f + 0.4135884f;
    o1 = (g - 0.4135884f) * 1.3f + 0.4135884f;
    o2 = (b - 0.4135884f) * 1.3f + 0.4135884f;
    float w = 1.0f;
    return make_float3(r + (o0 - r) * w, g + (o1 - g) * w, b + (o2 - b) * w);
}

__DEVICE__ float3 n_key(float r, float g, float b, int p_X, int p_Y, int p_W, int p_H, float p_scale) {
    float o0, o1, o2;
    o0 = cr_cct_enc(cr_cct_dec(r) * 1.14869835f);
    o1 = cr_cct_enc(cr_cct_dec(g) * 1.14869835f);
    o2 = cr_cct_enc(cr_cct_dec(b) * 1.14869835f);
    float w = 1.0f;
    return make_float3(r + (o0 - r) * w, g + (o1 - g) * w, b + (o2 - b) * w);
}

__DEVICE__ float3 transform(int p_Width, int p_Height, int p_X, int p_Y, float p_R, float p_G, float p_B) {
    float p_scale = (float)p_Width / 1920.0f;
    float3 c0 = make_float3(p_R, p_G, p_B);
    float3 c1 = n_exp(c0.x, c0.y, c0.z, p_X, p_Y, p_Width, p_Height, p_scale);
    float3 c2 = n_wb(c1.x, c1.y, c1.z, p_X, p_Y, p_Width, p_Height, p_scale);
    float3 c3 = n_pl(c2.x, c2.y, c2.z, p_X, p_Y, p_Width, p_Height, p_scale);
    float3 c4 = n_wh(c3.x, c3.y, c3.z, p_X, p_Y, p_Width, p_Height, p_scale);
    float3 c5 = n_cd(c4.x, c4.y, c4.z, p_X, p_Y, p_Width, p_Height, p_scale);
    float3 c6 = n_co(c5.x, c5.y, c5.z, p_X, p_Y, p_Width, p_Height, p_scale);
    float3 c7 = n_sa(c6.x, c6.y, c6.z, p_X, p_Y, p_Width, p_Height, p_scale);
    float3 c8 = n_cl(c7.x, c7.y, c7.z, p_X, p_Y, p_Width, p_Height, p_scale);
    float3 c9 = n_cr(c8.x, c8.y, c8.z, p_X, p_Y, p_Width, p_Height, p_scale);
    float3 c10 = n_cg(c9.x, c9.y, c9.z, p_X, p_Y, p_Width, p_Height, p_scale);
    float3 c11 = n_cdisp(c10.x, c10.y, c10.z, p_X, p_Y, p_Width, p_Height, p_scale);
    float3 c12 = n_hh(c11.x, c11.y, c11.z, p_X, p_Y, p_Width, p_Height, p_scale);
    float3 c13 = n_hs(c12.x, c12.y, c12.z, p_X, p_Y, p_Width, p_Height, p_scale);
    float3 c14 = n_hl(c13.x, c13.y, c13.z, p_X, p_Y, p_Width, p_Height, p_scale);
    float3 c15 = n_ls(c14.x, c14.y, c14.z, p_X, p_Y, p_Width, p_Height, p_scale);
    float3 c16 = n_ss(c15.x, c15.y, c15.z, p_X, p_Y, p_Width, p_Height, p_scale);
    float3 c17 = n_q(c16.x, c16.y, c16.z, p_X, p_Y, p_Width, p_Height, p_scale);
    float3 c18 = n_lm(c17.x, c17.y, c17.z, p_X, p_Y, p_Width, p_Height, p_scale);
    float3 c19 = n_win(c18.x, c18.y, c18.z, p_X, p_Y, p_Width, p_Height, p_scale);
    float3 c20 = n_vg(c19.x, c19.y, c19.z, p_X, p_Y, p_Width, p_Height, p_scale);
    float3 c21 = n_gr(c20.x, c20.y, c20.z, p_X, p_Y, p_Width, p_Height, p_scale);
    float3 c22 = n_pa(c21.x, c21.y, c21.z, p_X, p_Y, p_Width, p_Height, p_scale);
    float3 c23 = n_pb(c21.x, c21.y, c21.z, p_X, p_Y, p_Width, p_Height, p_scale);
    float3 c24 = make_float3((c22.x + c23.x) / 2.0f, (c22.y + c23.y) / 2.0f, (c22.z + c23.z) / 2.0f);
    float3 c25 = n_la(c24.x, c24.y, c24.z, p_X, p_Y, p_Width, p_Height, p_scale);
    float3 c26 = n_lb(c24.x, c24.y, c24.z, p_X, p_Y, p_Width, p_Height, p_scale);
    float3 c27 = make_float3(c25.x + 0.3f * (cr_cct_enc(_fmaxf(cr_cct_dec(c25.x) * cr_cct_dec(c26.x) / 0.18f, 0.0f)) - c25.x), c25.y + 0.3f * (cr_cct_enc(_fmaxf(cr_cct_dec(c25.y) * cr_cct_dec(c26.y) / 0.18f, 0.0f)) - c25.y), c25.z + 0.3f * (cr_cct_enc(_fmaxf(cr_cct_dec(c25.z) * cr_cct_dec(c26.z) / 0.18f, 0.0f)) - c25.z));
    float3 c28 = n_la(c27.x, c27.y, c27.z, p_X, p_Y, p_Width, p_Height, p_scale);
    float3 c29 = n_lb(c27.x, c27.y, c27.z, p_X, p_Y, p_Width, p_Height, p_scale);
    float3 c30 = make_float3(c28.x + 0.2f * (cr_cct_enc(_fmaxf(cr_cct_dec(c28.x) + cr_cct_dec(c29.x), 0.0f)) - c28.x), c28.y + 0.2f * (cr_cct_enc(_fmaxf(cr_cct_dec(c28.y) + cr_cct_dec(c29.y), 0.0f)) - c28.y), c28.z + 0.2f * (cr_cct_enc(_fmaxf(cr_cct_dec(c28.z) + cr_cct_dec(c29.z), 0.0f)) - c28.z));
    float3 c31 = n_pa(c30.x, c30.y, c30.z, p_X, p_Y, p_Width, p_Height, p_scale);
    float3 c32 = n_pb(c30.x, c30.y, c30.z, p_X, p_Y, p_Width, p_Height, p_scale);
    float3 c33 = make_float3(c31.x + 0.5f * (_fmaxf(c31.x, c32.x) - c31.x), c31.y + 0.5f * (_fmaxf(c31.y, c32.y) - c31.y), c31.z + 0.5f * (_fmaxf(c31.z, c32.z) - c31.z));
    float3 c34 = n_key(c33.x, c33.y, c33.z, p_X, p_Y, p_Width, p_Height, p_scale);
    return c34;
}
