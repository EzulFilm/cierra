    return x <= 0.0078125f ? 10.5402377416545f * x + 0.0729055341958355f : (_log2f(_fmaxf(x, 1e-12f)) + 9.72f) / 17.52f;
}

// skin hold: skin keeps its own colour
__DEVICE__ float3 n_skin_hold(float r, float g, float b, int p_X, int p_Y, int p_W, int p_H, float p_scale) {
    float o0, o1, o2;
    float y = cr_luma(r, g, b);
    float cb = (b - y) / 1.8556f, cr = (r - y) / 1.5748f;
    float k = 0.95f;
    float y2 = y, cb2 = cb * k, cr2 = cr * k;
    o0 = y2 + 1.5748f * cr2; o2 = y2 + 1.8556f * cb2; o1 = (y2 - 0.2126f * o0 - 0.0722f * o2) / 0.7152f;
    float m1 = 1.0f;
    {
      float qy = cr_luma(r, g, b), qcb = (b - qy) / 1.8556f, qcr = (r - qy) / 1.5748f;
      float qc = _sqrtf(qcb * qcb + qcr * qcr);
      float qh = qc < 1e-05f ? 0.0f : cr_hue(qcb, qcr);
      m1 *= 1.0f - cr_smoothstep(14.0f, 32.0f, _fabs(cr_mod360(qh - 142.0f + 180.0f) - 180.0f));
      m1 *= cr_band(qc, 0.006f, 0.09f, 0.01f);
      m1 *= cr_band(qy, 0.2f, 0.65f, 0.05f);
    }
    float w = (1.0f * m1);
    return make_float3(r + (o0 - r) * w, g + (o1 - g) * w, b + (o2 - b) * w);
}

__DEVICE__ float3 transform(int p_Width, int p_Height, int p_X, int p_Y, float p_R, float p_G, float p_B) {
