// Teal night
// Generated by Cierra 0.1 from program 4bf1f8d95bc8; edit the .cierra source, not this file.
// In: ACEScct (AP1) code values. Out: ACEScct code values. Use on an ACEScct timeline with an ACES 2.0
// output transform. Keyframed values are evaluated at frame 0.

__DEVICE__ float cr_luma(float r, float g, float b) { return 0.2126f * r + 0.7152f * g + 0.0722f * b; }
__DEVICE__ float cr_smoothstep(float e0, float e1, float x) {
    float t = _clampf((x - e0) / _fmaxf(e1 - e0, 1e-9f), 0.0f, 1.0f);
    return t * t * (3.0f - 2.0f * t);
}
__DEVICE__ float cr_band(float x, float lo, float hi, float s) {
    return cr_smoothstep(lo - s, lo + s, x) * (1.0f - cr_smoothstep(hi - s, hi + s, x));
}
__DEVICE__ float cr_mod360(float a) { return a - 360.0f * _floorf(a / 360.0f); }
__DEVICE__ float cr_hue(float cb, float cr) { return cr_mod360(_atan2f(cr, cb) * 57.29577951308232f); }
__DEVICE__ float cr_hue_w(float hue, float h0, float width) {
    float d = cr_mod360(hue - h0 + 180.0f) - 180.0f;
    return 0.5f + 0.5f * _cosf(3.14159265358979f * _clampf(d / width, -1.0f, 1.0f));
}
__DEVICE__ float cr_herm(float x, float x0, float x1, float y0, float y1, float m0, float m1) {
    float h = x1 - x0, t = (x - x0) / h, t2 = t * t, t3 = t2 * t;
    return (2.0f * t3 - 3.0f * t2 + 1.0f) * y0 + (t3 - 2.0f * t2 + t) * h * m0 + (-2.0f * t3 + 3.0f * t2) * y1
           + (t3 - t2) * h * m1;
}
__DEVICE__ float cr_cct_dec(float y) {
    return y <= 0.155251141552511f ? (y - 0.0729055341958355f) / 10.5402377416545f : _exp2f(y * 17.52f - 9.72f);
}
__DEVICE__ float cr_cct_enc(float x) {
    return x <= 0.0078125f ? 10.5402377416545f * x + 0.0729055341958355f : (_log2f(_fmaxf(x, 1e-12f)) + 9.72f) / 17.52f;
}

__DEVICE__ float curve_tone(float x) {
    if (x < 0.0729f) return 0.0729f + (x - 0.0729f) * 0.528352581f;
    if (x > 0.5543f) return 0.5479f + (x - 0.5543f) * 1.07246377f;
    if (x <= 0.0866f) return cr_herm(x, 0.0729f, 0.0866f, 0.0729f, 0.0822f, 0.528352581f, 1.96676408f);
    if (x <= 0.0882f) return cr_herm(x, 0.0866f, 0.0882f, 0.0822f, 0.0892f, 1.96676408f, 4.13988095f);
    if (x <= 0.0924f) return cr_herm(x, 0.0882f, 0.0924f, 0.0892f, 0.1056f, 4.13988095f, 3.39238095f);
    if (x <= 0.1074f) return cr_herm(x, 0.0924f, 0.1074f, 0.1056f, 0.1488f, 3.39238095f, 2.0608981f);
    if (x <= 0.1653f) return cr_herm(x, 0.1074f, 0.1653f, 0.1488f, 0.2207f, 2.0608981f, 1.0801214f);
    if (x <= 0.2683f) return cr_herm(x, 0.1653f, 0.2683f, 0.2207f, 0.3153f, 1.0801214f, 0.874774279f);
    if (x <= 0.3654f) return cr_herm(x, 0.2683f, 0.3654f, 0.3153f, 0.396f, 0.874774279f, 0.800466453f);
    if (x <= 0.4423f) return cr_herm(x, 0.3654f, 0.4423f, 0.396f, 0.4552f, 0.800466453f, 0.78098289f);
    if (x <= 0.4957f) return cr_herm(x, 0.4423f, 0.4957f, 0.4552f, 0.4975f, 0.78098289f, 0.81853577f);
    if (x <= 0.5273f) return cr_herm(x, 0.4957f, 0.5273f, 0.4975f, 0.5242f, 0.81853577f, 0.827940991f);
    if (x <= 0.5474f) return cr_herm(x, 0.5273f, 0.5474f, 0.5242f, 0.5405f, 0.827940991f, 0.941704521f);
    return cr_herm(x, 0.5474f, 0.5543f, 0.5405f, 0.5479f, 0.941704521f, 1.07246377f);
}

// tone
__DEVICE__ float3 n_tone(float r, float g, float b, int p_X, int p_Y, int p_W, int p_H, float p_scale) {
    float o0, o1, o2;
    float yc = cr_luma(r, g, b); float dy = curve_tone(yc) - yc;
    o0 = r + dy; o1 = g + dy; o2 = b + dy;
    float w = 1.0f;
    return make_float3(r + (o0 - r) * w, g + (o1 - g) * w, b + (o2 - b) * w);
}

// cool (everything except skin tones)
__DEVICE__ float3 n_cool(float r, float g, float b, int p_X, int p_Y, int p_W, int p_H, float p_scale) {
    float o0, o1, o2;
    o0 = cr_cct_enc(cr_cct_dec(r) * 0.784584098f);
    o1 = cr_cct_enc(cr_cct_dec(g) * 0.965936329f);
    o2 = cr_cct_enc(cr_cct_dec(b) * 1.27456063f);
    float m1 = 1.0f;
    {
      float qy = cr_luma(r, g, b), qcb = (b - qy) / 1.8556f, qcr = (r - qy) / 1.5748f;
      float qc = _sqrtf(qcb * qcb + qcr * qcr);
      float qh = qc < 1e-05f ? 0.0f : cr_hue(qcb, qcr);
      m1 *= 1.0f - cr_smoothstep(23.0f, 44.6f, _fabs(cr_mod360(qh - 141.0f + 180.0f) - 180.0f));
      m1 *= cr_band(qc, 0.008f, 1.0f, 0.012f);
      m1 *= cr_band(qy, 0.05f, 0.95f, 0.06f);
    }
    float w = (1.0f * (1.0f - m1));
    return make_float3(r + (o0 - r) * w, g + (o1 - g) * w, b + (o2 - b) * w);
}

// keep practicals warm (undo the cool shift above ~1 stop under display white)
__DEVICE__ float3 n_keep_practicals_warm(float r, float g, float b, int p_X, int p_Y, int p_W, int p_H, float p_scale) {
    float o0, o1, o2;
    o0 = cr_cct_enc(cr_cct_dec(r) * 1.27456063f);
    o1 = cr_cct_enc(cr_cct_dec(g) * 1.03526492f);
    o2 = cr_cct_enc(cr_cct_dec(b) * 0.784584098f);
    float m1 = cr_band(cr_luma(r, g, b), 0.49f, 1.3f, 0.03f);
    float w = (1.0f * m1);
    return make_float3(r + (o0 - r) * w, g + (o1 - g) * w, b + (o2 - b) * w);
}

// teal shadows (not on skin)
__DEVICE__ float3 n_teal_shadows(float r, float g, float b, int p_X, int p_Y, int p_W, int p_H, float p_scale) {
    float o0, o1, o2;
    float y = _clampf(cr_luma(r, g, b), 0.0f, 1.0f);
    float sh = 1.0f - cr_smoothstep(0.1f, 0.4635884f, y);
    float d = (y - 0.4135884f) / 0.18f; float mi = _expf(-d * d);
    float hi = cr_smoothstep(0.3635884f, 0.75f, y);
    o0 = r + -0.012f * sh + -0.004f * mi + 0.012f * hi + 0.0f;
    o1 = g + 0.004f * sh + 0.0f * mi + 0.004f * hi + 0.0f;
    o2 = b + 0.016f * sh + 0.006f * mi + -0.01f * hi + 0.0f;
    float m1 = 1.0f;
    {
      float qy = cr_luma(r, g, b), qcb = (b - qy) / 1.8556f, qcr = (r - qy) / 1.5748f;
      float qc = _sqrtf(qcb * qcb + qcr * qcr);
      float qh = qc < 1e-05f ? 0.0f : cr_hue(qcb, qcr);
      m1 *= 1.0f - cr_smoothstep(23.0f, 44.6f, _fabs(cr_mod360(qh - 141.0f + 180.0f) - 180.0f));
      m1 *= cr_band(qc, 0.008f, 1.0f, 0.012f);
    }
    float w = (1.0f * (1.0f - m1));
    return make_float3(r + (o0 - r) * w, g + (o1 - g) * w, b + (o2 - b) * w);
}

// warm skin and practicals, teal up, greens down
__DEVICE__ float3 n_warm_skin_teal_up(float r, float g, float b, int p_X, int p_Y, int p_W, int p_H, float p_scale) {
    float o0, o1, o2;
    float y = cr_luma(r, g, b);
    float cb = (b - y) / 1.8556f, cr = (r - y) / 1.5748f;
    float hue = cr_hue(cb, cr);
    float hv_s = 0.0f, hv_w = 0.0f, hv_k;
    hv_k = cr_hue_w(hue, 141.0f, 45.0f); hv_s += hv_k * 0.12f; hv_w += hv_k;
    hv_k = cr_hue_w(hue, 310.0f, 50.0f); hv_s += hv_k * 0.2f; hv_w += hv_k;
    hv_k = cr_hue_w(hue, 220.0f, 40.0f); hv_s += hv_k * -0.15f; hv_w += hv_k;
    float hv = 1.0f + hv_s / _fmaxf(hv_w, 1.0f);
    float y2 = y, cb2 = cb * hv, cr2 = cr * hv;
    o0 = y2 + 1.5748f * cr2; o2 = y2 + 1.8556f * cb2; o1 = (y2 - 0.2126f * o0 - 0.0722f * o2) / 0.7152f;
    float w = 1.0f;
    return make_float3(r + (o0 - r) * w, g + (o1 - g) * w, b + (o2 - b) * w);
}

// skin protect
__DEVICE__ float3 n_skin_protect(float r, float g, float b, int p_X, int p_Y, int p_W, int p_H, float p_scale) {
    float o0, o1, o2;
    float y = cr_luma(r, g, b);
    float cb = (b - y) / 1.8556f, cr = (r - y) / 1.5748f;
    float k = 1.0f;
    float hue = cr_hue(cb, cr);
    float skin = 1.0f - cr_smoothstep(15.0f, 40.0f, _fabs(cr_mod360(hue - 141.0f + 180.0f) - 180.0f));
    k = k + (1.0f - k) * skin * 1.0f;
    float y2 = y, cb2 = cb * k, cr2 = cr * k;
    o0 = y2 + 1.5748f * cr2; o2 = y2 + 1.8556f * cb2; o1 = (y2 - 0.2126f * o0 - 0.0722f * o2) / 0.7152f;
    float w = 1.0f;
    return make_float3(r + (o0 - r) * w, g + (o1 - g) * w, b + (o2 - b) * w);
}

__DEVICE__ float3 transform(int p_Width, int p_Height, int p_X, int p_Y, float p_R, float p_G, float p_B) {
    float p_scale = (float)p_Width / 1920.0f;
    float3 c0 = make_float3(p_R, p_G, p_B);
    float3 c1 = n_tone(c0.x, c0.y, c0.z, p_X, p_Y, p_Width, p_Height, p_scale);
    float3 c2 = n_cool(c1.x, c1.y, c1.z, p_X, p_Y, p_Width, p_Height, p_scale);
    float3 c3 = n_keep_practicals_warm(c2.x, c2.y, c2.z, p_X, p_Y, p_Width, p_Height, p_scale);
    float3 c4 = n_teal_shadows(c3.x, c3.y, c3.z, p_X, p_Y, p_Width, p_Height, p_scale);
    float3 c5 = n_warm_skin_teal_up(c4.x, c4.y, c4.z, p_X, p_Y, p_Width, p_Height, p_scale);
    float3 c6 = n_skin_protect(c5.x, c5.y, c5.z, p_X, p_Y, p_Width, p_Height, p_scale);
    return c6;
}
