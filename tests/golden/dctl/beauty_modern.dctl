// In: ACEScct (AP1) code values. Out: ACEScct code values. Use on an ACEScct timeline with an ACES 2.0
// output transform. Keyframed values are evaluated at frame 0.

__DEVICE__ float cr_luma(float r, float g, float b) { return 0.2126f * r + 0.7152f * g + 0.0722f * b; }
__DEVICE__ float cr_smoothstep(float e0, float e1, float x) {
    float t = _clampf((x - e0) / _fmaxf(e1 - e0, 1e-9f), 0.0f, 1.0f);
    return t * t * (3.0f - 2.0f * t);
}
__DEVICE__ float cr_band(float x, float lo, float hi, float s) {
    return cr_smoothstep(lo - s, lo + s, x) * (1.0f - cr_smoothstep(hi - s, hi + s, x));
}
__DEVICE__ float cr_mod360(float a) { return a - 360.0f * _floorf(a / 360.0f); }
__DEVICE__ float cr_hue(float cb, float cr) { return cr_mod360(_atan2f(cr, cb) * 57.29577951308232f); }
__DEVICE__ float cr_hue_w(float hue, float h0, float width) {
    float d = cr_mod360(hue - h0 + 180.0f) - 180.0f;
    return 0.5f + 0.5f * _cosf(3.14159265358979f * _clampf(d / width, -1.0f, 1.0f));
}
__DEVICE__ float cr_herm(float x, float x0, float x1, float y0, float y1, float m0, float m1) {
    float h = x1 - x0, t = (x - x0) / h, t2 = t * t, t3 = t2 * t;
    return (2.0f * t3 - 3.0f * t2 + 1.0f) * y0 + (t3 - 2.0f * t2 + t) * h * m0 + (-2.0f * t3 + 3.0f * t2) * y1
           + (t3 - t2) * h * m1;
}
__DEVICE__ float cr_cct_dec(float y) {
    return y <= 0.155251141552511f ? (y - 0.0729055341958355f) / 10.5402377416545f : _exp2f(y * 17.52f - 9.72f);
}
__DEVICE__ float cr_cct_enc(float x) {
    return x <= 0.0078125f ? 10.5402377416545f * x + 0.0729055341958355f : (_log2f(_fmaxf(x, 1e-12f)) + 9.72f) / 17.52f;
}

__DEVICE__ float curve_bright_open_mids(float x) {
    if (x < 0.0729f) return 0.0729f + (x - 0.0729f) * 0.983060418f;
    if (x > 1.0f) return 1.0f + (x - 1.0f) * 0.983333333f;
    if (x <= 0.25f) return cr_herm(x, 0.0729f, 0.25f, 0.0729f, 0.247f, 0.983060418f, 1.04443541f);
    if (x <= 0.4135f) return cr_herm(x, 0.25f, 0.4135f, 0.247f, 0.4278f, 1.04443541f, 1.04448029f);
    if (x <= 0.55f) return cr_herm(x, 0.4135f, 0.55f, 0.4278f, 0.562f, 1.04448029f, 0.968241758f);
    if (x <= 0.7f) return cr_herm(x, 0.55f, 0.7f, 0.562f, 0.705f, 0.968241758f, 0.968333333f);
    return cr_herm(x, 0.7f, 1.0f, 0.705f, 1.0f, 0.968333333f, 0.983333333f);
}

// bright, open mids (+1/4 stop at grey); deep shadows and black held
__DEVICE__ float3 n_bright_open_mids(float r, float g, float b, int p_X, int p_Y, int p_W, int p_H, float p_scale) {
    float o0, o1, o2;
    float yc = cr_luma(r, g, b); float dy = curve_bright_open_mids(yc) - yc;
    o0 = r + dy; o1 = g + dy; o2 = b + dy;
    float w = 1.0f;
    return make_float3(r + (o0 - r) * w, g + (o1 - g) * w, b + (o2 - b) * w);
}

// richer colour, skin protected
__DEVICE__ float3 n_richer_colour(float r, float g, float b, int p_X, int p_Y, int p_W, int p_H, float p_scale) {
    float o0, o1, o2;
    float y = cr_luma(r, g, b);
    float cb = (b - y) / 1.8556f, cr = (r - y) / 1.5748f;
    float k = 1.05f;
    float hue = cr_hue(cb, cr);
    float skin = 1.0f - cr_smoothstep(15.0f, 40.0f, _fabs(cr_mod360(hue - 141.0f + 180.0f) - 180.0f));
    k = k + (1.0f - k) * skin * 1.0f;
    float y2 = y, cb2 = cb * k, cr2 = cr * k;
    o0 = y2 + 1.5748f * cr2; o2 = y2 + 1.8556f * cb2; o1 = (y2 - 0.2126f * o0 - 0.0722f * o2) / 0.7152f;
    float w = 1.0f;
    return make_float3(r + (o0 - r) * w, g + (o1 - g) * w, b + (o2 - b) * w);
}

// skin warmth: chroma up on skin only
__DEVICE__ float3 n_skin_warmth(float r, float g, float b, int p_X, int p_Y, int p_W, int p_H, float p_scale) {
    float o0, o1, o2;
    float y = cr_luma(r, g, b);
    float cb = (b - y) / 1.8556f, cr = (r - y) / 1.5748f;
    float k = 1.16f;
    float y2 = y, cb2 = cb * k, cr2 = cr * k;
    o0 = y2 + 1.5748f * cr2; o2 = y2 + 1.8556f * cb2; o1 = (y2 - 0.2126f * o0 - 0.0722f * o2) / 0.7152f;
    float m1 = 1.0f;
    {
      float qy = cr_luma(r, g, b), qcb = (b - qy) / 1.8556f, qcr = (r - qy) / 1.5748f;
      float qc = _sqrtf(qcb * qcb + qcr * qcr);
      float qh = qc < 1e-05f ? 0.0f : cr_hue(qcb, qcr);
      m1 *= 1.0f - cr_smoothstep(14.0f, 32.0f, _fabs(cr_mod360(qh - 142.0f + 180.0f) - 180.0f));
      m1 *= cr_band(qc, 0.006f, 0.05f, 0.01f);
      m1 *= cr_band(qy, 0.2f, 0.6f, 0.05f);
    }
    float w = (1.0f * m1);
    return make_float3(r + (o0 - r) * w, g + (o1 - g) * w, b + (o2 - b) * w);
}

// strong blues held back
__DEVICE__ float3 n_strong_blues_held(float r, float g, float b, int p_X, int p_Y, int p_W, int p_H, float p_scale) {
    float o0, o1, o2;
    float y = cr_luma(r, g, b);
    float cb = (b - y) / 1.8556f, cr = (r - y) / 1.5748f;
    float hue = cr_hue(cb, cr);
    float hv_s = 0.0f, hv_w = 0.0f, hv_k;
    hv_k = cr_hue_w(hue, 350.0f, 40.0f); hv_s += hv_k * -0.06f; hv_w += hv_k;
    float hv = 1.0f + hv_s / _fmaxf(hv_w, 1.0f);
    float y2 = y, cb2 = cb * hv, cr2 = cr * hv;
    o0 = y2 + 1.5748f * cr2; o2 = y2 + 1.8556f * cb2; o1 = (y2 - 0.2126f * o0 - 0.0722f * o2) / 0.7152f;
    float w = 1.0f;
    return make_float3(r + (o0 - r) * w, g + (o1 - g) * w, b + (o2 - b) * w);
}

__DEVICE__ float curve_mid_colour(float x) {
    if (x < 0.2f) return 0.95f + (x - 0.2f) * 0.666666667f;
    if (x > 0.6f) return 0.92f + (x - 0.6f) * -0.866666667f;
    if (x <= 0.35f) return cr_herm(x, 0.2f, 0.35f, 0.95f, 1.05f, 0.666666667f, 0.0f);
    if (x <= 0.45f) return cr_herm(x, 0.35f, 0.45f, 1.05f, 1.05f, 0.0f, 0.0f);
    return cr_herm(x, 0.45f, 0.6f, 1.05f, 0.92f, 0.0f, -0.866666667f);
}

// mid colour, quiet shadows and highlights
__DEVICE__ float3 n_mid_colour(float r, float g, float b, int p_X, int p_Y, int p_W, int p_H, float p_scale) {
    float o0, o1, o2;
    float y = cr_luma(r, g, b);
    float cb = (b - y) / 1.8556f, cr = (r - y) / 1.5748f;
    float k = curve_mid_colour(y);
    float y2 = y, cb2 = cb * k, cr2 = cr * k;
    o0 = y2 + 1.5748f * cr2; o2 = y2 + 1.8556f * cb2; o1 = (y2 - 0.2126f * o0 - 0.0722f * o2) / 0.7152f;
    float w = 1.0f;
    return make_float3(r + (o0 - r) * w, g + (o1 - g) * w, b + (o2 - b) * w);
}

__DEVICE__ float3 transform(int p_Width, int p_Height, int p_X, int p_Y, float p_R, float p_G, float p_B) {
    float p_scale = (float)p_Width / 1920.0f;
    float3 c0 = make_float3(p_R, p_G, p_B);
    float3 c1 = n_bright_open_mids(c0.x, c0.y, c0.z, p_X, p_Y, p_Width, p_Height, p_scale);
    float3 c2 = n_richer_colour(c1.x, c1.y, c1.z, p_X, p_Y, p_Width, p_Height, p_scale);
    float3 c3 = n_skin_warmth(c2.x, c2.y, c2.z, p_X, p_Y, p_Width, p_Height, p_scale);
    float3 c4 = n_strong_blues_held(c3.x, c3.y, c3.z, p_X, p_Y, p_Width, p_Height, p_scale);
    float3 c5 = n_mid_colour(c4.x, c4.y, c4.z, p_X, p_Y, p_Width, p_Height, p_scale);
    return c5;
}
